{
    "name":  "@qiaoy01/mission",
    "version":  "0.1.9",
    "description":  "Persistent long-horizon autonomous mission runtime for DeepSeek Harness: dependency DAG, independent verification, replan-on-failure, lease ownership.",
    "license":  "MIT",
    "type":  "module",
    "scripts":  {
                    "build":  "node scripts/build.mjs"
                },
    "main":  "lib/index.js",
    "types":  "lib/index.d.ts",
    "files":  [
                  "lib/",
                  "cordis.patch.yml",
                  "package.json",
                  "README.md",
                  "README.zh-CN.md",
                  "LICENSE"
              ],
    "exports":  {
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./invariant":  {
                                        "types":  "./lib/src/invariant.d.ts",
                                        "default":  "./lib/src/invariant.js"
                                    },
                    "./tool":  {
                                   "types":  "./lib/src/tools.d.ts",
                                   "default":  "./lib/src/tools.js"
                               },
                    "./trigger":  {
                                   "types":  "./lib/src/trigger.d.ts",
                                   "default":  "./lib/src/trigger.js"
                               },
                    "./driver-host":  {
                                          "types":  "./lib/src/driver-host.d.ts",
                                          "default":  "./lib/src/driver-host.js"
                                      },
                    "./projection":  {
                                         "types":  "./lib/src/projection.d.ts",
                                         "default":  "./lib/src/projection.js"
                                     },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "*",
                             "@deepseek-ai/dsh-agent":  "*",
                             "@deepseek-ai/dsh-invariants":  "*",
                             "@deepseek-ai/dsh-llm":  "*",
                             "@deepseek-ai/dsh-session":  "*",
                             "@deepseek-ai/dsh-session-projection":  "*",
                             "@deepseek-ai/dsh-subagent":  "*",
                             "@deepseek-ai/dsh-tools":  "*",
                             "@deepseek-ai/dsh-commands":  "*",
                             "@deepseek-ai/dsh-system-prompt":  "*",
                             "zod":  "*"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "4.0.1",
                            "@deepseek-ai/dsh-agent":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-invariants":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-llm":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-session":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-session-projection":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-subagent":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-tools":  "0.1.0-rc.6",
                            "typescript":  "^5.9.0",
                            "zod":  "4.4.3"
                        }
}